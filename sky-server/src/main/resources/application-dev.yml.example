# 复制为 application-dev.yml 后填写本机值。真实配置文件被 .gitignore 排除，禁止提交密码和密钥。
spring:
  flyway:
    # 当前已人工完整迁移的 Docker 演示库填 23；全新 Docker 库首次启动填 0。
    baseline-version: 23
sky:
  performance:
    # k6 测试用户生成接口仅在 dev profile 且此项显式为 true 时注册；默认必须关闭。
    enabled: false
  messaging:
    # 仅用于本地演示消费者失败重试和 DLQ。正常开发必须保持 false，生产环境不配置此项。
    fault-injection:
      order-paid-consumer-fail: false
    # 死信重放入口仅在 dev profile 且此项显式为 true 时注册；正常开发保持 false。
    replay:
      enabled: false
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    # 使用本仓库 docker-compose.yml 时，宿主机映射端口为 3307。
    port: 3307
    database: yuexuan_local_service
    username: root
    # Docker Compose 默认 MySQL 密码来自 .env 的 MYSQL_ROOT_PASSWORD。
    password:
  redis:
    host: localhost
    # 使用本仓库 docker-compose.yml 时，宿主机映射端口为 6380。
    port: 6380
    # Docker Compose 默认 Redis 不启用密码；若自行配置 requirepass，再填写密码。
    password: CHANGE_ME
    database: 0
  rabbitmq:
    host: localhost
    port: 5672
    username: yuexuan
    password: CHANGE_ME
  alioss:
    endpoint: CHANGE_ME
    access-key-id: CHANGE_ME
    access-key-secret: CHANGE_ME
    bucket-name: CHANGE_ME
  wechat:
    mock-login: true
    mock-openid: local-dev-user
    appid: CHANGE_ME
    secret: CHANGE_ME
    mchid: CHANGE_ME
    mch-serial-no: CHANGE_ME
    private-key-file-path: CHANGE_ME
    api-v3-key: CHANGE_ME
    wechat-pay-cert-file-path: CHANGE_ME
    notifyUrl: http://localhost:8080/notify/paySuccess
    refundNotifyUrl: http://localhost:8080/notify/refundSuccess

# 排查单条 MyBatis SQL 时才临时开启；压测和日常运行应保持 application.yml 中的 info。
# logging:
#   level:
#     com:
#       sky:
#         mapper: debug
