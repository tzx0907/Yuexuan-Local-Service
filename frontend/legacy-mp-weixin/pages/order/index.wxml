<view class="yx-order data-v-0ca91b30"><uni-nav-bar vue-id="3bc35b9e-1" left-icon="back" leftIcon="arrowleft" title="确认订单" statusBar="true" fixed="true" color="#ffffff" backgroundColor="#1677FF" data-event-opts="{{[['^clickLeft',[['goBack']]]]}}" bind:clickLeft="__e" class="data-v-0ca91b30" bind:__l="__l"></uni-nav-bar><view class="yx-order-body data-v-0ca91b30"><view wx:if="{{deliveryMode==='delivery'}}" class="yx-address-card data-v-0ca91b30" data-event-opts="{{[['tap',[['goAddress']]]]}}" bindtap="__e"><view class="yx-address-label data-v-0ca91b30">收货地址</view><block wx:if="{{address}}"><view class="yx-address data-v-0ca91b30">{{address}}</view><view class="yx-contact data-v-0ca91b30">{{nickName}} {{phoneNumber}}</view><view class="yx-delivery-tip data-v-0ca91b30">配送员将按此地址为您送达</view></block><block wx:else><view class="yx-address-empty data-v-0ca91b30">请选择收货地址 ›</view></block></view><view wx:else class="yx-address-card yx-pickup-card data-v-0ca91b30"><view class="yx-address-label data-v-0ca91b30">配送方式</view><view class="yx-pickup-name data-v-0ca91b30">用户自提</view><view class="yx-delivery-tip data-v-0ca91b30">下单后请凭订单号到悦选服务点取货</view></view><view class="yx-goods-card data-v-0ca91b30"><view class="yx-card-title data-v-0ca91b30">悦选商品清单</view><block wx:for="{{$root.l0}}" wx:for-item="obj" wx:for-index="index" wx:key="index"><view class="yx-goods-row data-v-0ca91b30"><image src="{{obj.$orig.image}}" mode="aspectFill"></image><view class="yx-goods-info data-v-0ca91b30"><view>{{obj.$orig.name}}</view><view class="yx-goods-spec data-v-0ca91b30">{{obj.$orig.dishFlavor||'默认规格'}}</view><view class="yx-goods-stock data-v-0ca91b30">单价 ￥{{obj.g0}}</view></view><view>×{{obj.$orig.number}}</view><view class="yx-goods-price data-v-0ca91b30">￥{{obj.g1}}</view></view></block><view class="yx-total-row data-v-0ca91b30"><text>商品小计</text><text>￥{{$root.g2}}</text></view><view wx:if="{{!$root.gService}}" class="yx-total-row data-v-0ca91b30"><text>商品打包服务费</text><text>￥{{$root.gPacking}}</text></view><view wx:if="{{deliveryMode==='delivery'&&!$root.gService}}" class="yx-total-row data-v-0ca91b30"><text>配送费</text><text>￥{{$root.gDelivery}}</text></view></view><view class="yx-extra-card data-v-0ca91b30"><view data-event-opts="{{[['tap',[['goRemark']]]]}}" bindtap="__e" class="yx-extra-row data-v-0ca91b30"><text>订单备注</text><text>{{remark?remark:'选填，如配送偏好'}} ›</text></view><block wx:if="{{$root.gService}}"><view class="yx-extra-row data-v-0ca91b30"><text>服务方式</text><text>预约上门</text></view><view class="yx-extra-row data-v-0ca91b30"><text>预约日期</text><picker mode="date" start="{{serviceDateStart}}" value="{{serviceAppointmentDate}}" data-event-opts="{{[['change',[['selectServiceDate']]]]}}" bindchange="__e"><text class="yx-picker-value data-v-0ca91b30">{{serviceAppointmentDate||'请选择日期'}} ›</text></picker></view><view class="yx-extra-row data-v-0ca91b30"><text>上门时间</text><picker mode="time" start="08:00" end="21:00" value="{{arrivalTime}}" data-event-opts="{{[['change',[['selectServiceTime']]]]}}" bindchange="__e"><text class="yx-picker-value data-v-0ca91b30">{{arrivalTime||'请选择时间'}} ›</text></picker></view></block><block wx:else><view class="yx-extra-row data-v-0ca91b30"><text>配送方式</text><view class="yx-delivery-options data-v-0ca91b30"><text class="yx-delivery-option data-v-0ca91b30 {{deliveryMode==='delivery'?'selected':''}}" data-event-opts="{{[['tap',[['selectDelivery']]]]}}" catchtap="__e">送货上门</text><text class="yx-delivery-option data-v-0ca91b30 {{deliveryMode==='pickup'?'selected':''}}" data-event-opts="{{[['tap',[['selectPickup']]]]}}" catchtap="__e">到店自提</text></view></view></block></view></view><view class="yx-order-footer data-v-0ca91b30"><view>合计 <text>￥{{$root.g3}}</text></view><view data-event-opts="{{[['tap',[['payOrderHandle']]]]}}" bindtap="__e" class="yx-pay-btn data-v-0ca91b30">提交订单</view></view></view>
